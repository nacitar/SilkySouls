<UserControl x:Class="SilkySouls.Views.UtilityTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:gameIds="clr-namespace:SilkySouls.GameIds"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                BorderThickness="1"
                BorderBrush="#333"
                CornerRadius="3"
                Margin="0,0,0,10">
            <StackPanel Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Content="Enable Draw"
                              IsChecked="{Binding IsDrawEnabled}"
                              Grid.Column="0" />

                    <Border
                        Background="#3498db"
                        CornerRadius="10"
                        Width="12"
                        Height="12"
                        Margin="10,0,0,0"
                        Cursor="Hand"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left"
                        Grid.Column="1"
                        MouseLeftButtonDown="DrawInfoBorder_MouseLeftButtonDown">
                        <TextBlock Text="i"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"
                                   FontSize="10" />
                    </Border>
                </Grid>

                <UniformGrid Columns="2" Margin="20,5,0,0">
                    <CheckBox Content="Hitbox View"
                              IsEnabled="{Binding IsDrawEnabled}"
                              IsChecked="{Binding IsHitboxEnabled}"
                              Margin="0,2" />

                    <CheckBox Content="Player Sound View"
                              IsEnabled="{Binding IsDrawEnabled}"
                              IsChecked="{Binding IsSoundViewEnabled}"
                              Margin="0,2" />

                    <CheckBox Content="Draw Events"
                              IsEnabled="{Binding IsDrawEnabled}"
                              IsChecked="{Binding IsDrawEventEnabled}"
                              Margin="0,2" />

                </UniformGrid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                BorderThickness="1"
                BorderBrush="#333"
                CornerRadius="3"
                Margin="0,0,0,10">
            <StackPanel Margin="10">
                <UniformGrid Columns="2" Rows="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox Content="No Clip"
                                  IsChecked="{Binding IsNoClipEnabled}"
                                  IsEnabled="{Binding AreOptionsEnabled}"
                                  Margin="0,2"
                                  Grid.Column="0" />

                        <Border
                            Background="#3498db"
                            CornerRadius="10"
                            Width="12"
                            Height="12"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            Grid.Column="1"
                            ToolTip="Vertical movement with Ctrl/Space or L2/R2 on controller"
                            ToolTipService.InitialShowDelay='100'>
                            <TextBlock Text="i"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       FontSize="10" />
                        </Border>
                    </Grid>
                    <CheckBox Content="Visible Tomb of the Giants"
                              IsChecked="{Binding IsFilterRemoveEnabled}"
                              Margin="0,2" />
                    <CheckBox Content="Death Cam"
                              IsChecked="{Binding IsDeathCamEnabled}"
                              IsEnabled="{Binding AreOptionsEnabled}"
                              Margin="0,2" />
                    <CheckBox Content="100% BKH drop"
                              IsChecked="{Binding IsGuaranteedBkhEnabled}"
                              Margin="0,5,0,0" />
                </UniformGrid>
            </StackPanel>
        </Border>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderThickness="1"
                    BorderBrush="#333"
                    CornerRadius="3"
                    Margin="0,0,5,0">
                <TabControl Margin="5">
                    <TabItem Header="Menu">
                        <StackPanel Margin="5">
                            <Button Content="Level Up"
                                    Command="{Binding ShowLevelUpMenuCommand}"
                                    IsEnabled="{Binding AreOptionsEnabled}"
                                    Height="25"
                                    Margin="0,2" />

                            <Button Content="Attunement"
                                    Command="{Binding ShowAttunementMenuCommand}"
                                    IsEnabled="{Binding AreOptionsEnabled}"
                                    Height="25"
                                    Margin="0,2" />

                            <Button Content="Upgrade Weapon"
                                    Command="{Binding UpgradeWeaponCommand}"
                                    IsEnabled="{Binding AreOptionsEnabled}"
                                    Height="25"
                                    Margin="0,2" />

                            <Button Content="Upgrade Armor"
                                    Command="{Binding UpgradeArmorCommand}"
                                    IsEnabled="{Binding AreOptionsEnabled}"
                                    Height="25"
                                    Margin="0,2" />

                            <Button Content="Travel"
                                    Command="{Binding OpenWarpMenuCommand}"
                                    IsEnabled="{Binding AreOptionsEnabled}"
                                    Height="25"
                                    Margin="0,2" />

                            <Button Content="Bottomless Box"
                                    Command="{Binding OpenBottomlessBoxCommand}"
                                    IsEnabled="{Binding AreOptionsEnabled}"
                                    Height="25"
                                    Margin="0,2" />

                            <Button Content="Feed"
                                    Command="{Binding OpenFeedMenuCommand}"
                                    IsEnabled="{Binding AreOptionsEnabled}"
                                    Height="25"
                                    Margin="0,2" />
                        </StackPanel>
                    </TabItem>
                    <TabItem Header="Shops">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                            <WrapPanel Margin="5" HorizontalAlignment="Center">
                                <Button Content="Male Ud."
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.MaleUdMerchant}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Female Ud."
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.FemaleUdMerchant}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Zena"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Zena}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Patches"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Patches}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Shiva"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Shiva}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Griggs"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Griggs}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Dusk"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Dusk}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Ingward"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Ingward}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Laurentius"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Laurentius}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Eingyi"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Eingyi}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Quelana"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Quelana}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Petrus"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Petrus}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Reah"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Reah}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Oswald"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Oswald}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Logan"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Logan}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Crestfallen"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.CrestfallenMerchant}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Chester"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Chester}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Elizabeth"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Elizabeth}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                                <Button Content="Gough"
                                        IsEnabled="{Binding AreOptionsEnabled}"
                                        Command="{Binding OpenShopCommand}"
                                        CommandParameter="{x:Static gameIds:ShopParams.Gough}"
                                        Height="24"
                                        Width="80"
                                        Margin="2" />
                            </WrapPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>

        </Grid>
    </Grid>
</UserControl>
